# ---- Server ----
PORT=4000
NODE_ENV=production
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=https://www.solcacao.com,http://localhost:8080

# ---- Azure SQL Database ----
DB_SERVER=solcacao-sql.database.windows.net
DB_PORT=1433
DB_NAME=solcacao
DB_USER=solcacao_admin
DB_PASSWORD=CHANGE_ME
# Azure SQL requires encryption. Keep "true" / "false" in production.
DB_ENCRYPT=true
DB_TRUST_CERT=false

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---- File storage for B2B uploads: "local" or "azure" ----
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=b2b-uploads

# ---- SMTP (Nodemailer) ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@solcacao.com
SMTP_PASS=CHANGE_ME
MAIL_FROM="SolCacao <no-reply@solcacao.com>"
MAIL_TO_WHOLESALE=wholesale@solcacao.com
MAIL_TO_SUPPORT=hello@solcacao.com